---
import { Image } from 'astro:assets';
import { site } from '../config';
import ctaRunner from '../assets/images/cta-runner.jpg';

const goals = ['Build strength', 'Lose weight', 'Improve fitness', 'Personal training', 'Not sure yet'];
const times = ['Morning', 'Afternoon', 'Evening', 'Weekend'];
---

<section id="contact" class="cta section grain">
  <Image src={ctaRunner} alt="" widths={[800, 1400]} sizes="100vw" class="backdrop" aria-hidden="true" />
  <div class="container grid">
    <div class="copy">
      <h2 data-reveal="text">Your next chapter starts here.</h2>
      <p data-reveal="up">Your strongest days are ahead. Take the first step today.</p>
      <div class="buttons">
        <a data-magnetic href="#enquiry" class="btn btn--black join">Join the Club</a>
        <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn wa">WhatsApp us</a>
      </div>
    </div>

    <div id="enquiry" class="card" data-reveal="up">
      <!-- Prototype only: wire `data-enquiry-form` to a real backend, CRM, email or WhatsApp API. -->
      <form data-enquiry-form>
        <div class="intro">
          <h3>Book a free gym tour</h3>
          <p>We'll reply on WhatsApp within one working day.</p>
        </div>
        <label>Name
          <input required name="name" autocomplete="name" placeholder="Your full name" />
        </label>
        <label>Phone / WhatsApp
          <input required type="tel" name="phone" autocomplete="tel" placeholder="+91" />
        </label>
        <div class="row">
          <label>Main goal (optional)
            <select name="goal">{goals.map((g) => <option>{g}</option>)}</select>
          </label>
          <label>Visit time (optional)
            <select name="time">{times.map((t) => <option>{t}</option>)}</select>
          </label>
        </div>
        <button type="submit" class="btn btn--primary submit">Book a Free Gym Tour</button>
        <p class="privacy">We only use your details to arrange your visit. No spam.</p>
      </form>

      <div class="success" data-enquiry-success hidden aria-live="polite">
        <span class="check" aria-hidden="true">✓</span>
        <h3>See you soon, <span data-sent-name>friend</span>.</h3>
        <p>Our team will message you on WhatsApp to confirm your tour time.</p>
        <button type="button" data-enquiry-reset>Send another</button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, var(--color-orange) 0%, var(--color-flame) 30%, var(--color-ember) 68%, var(--color-black) 100%);
  }
  /* Sunset runner glowing up out of the dark end of the gradient */
  .cta :global(.backdrop) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%;
    filter: saturate(1.2) contrast(1.1); mix-blend-mode: screen; opacity: 0.7; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 30%, #000 70%, #000 82%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 30%, #000 70%, #000 82%, transparent 100%);
  }
  .grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(3rem, 6vw, 6rem); align-items: start;
  }
  .copy { display: flex; flex-direction: column; gap: 28px; color: var(--color-black); }
  h2 {
    margin: 0; font-family: var(--font-display); font-weight: 400;
    font-size: clamp(3.75rem, 9vw, 8.5rem); line-height: 0.86; text-transform: uppercase;
  }
  .copy p { margin: 0; max-width: 440px; font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; font-weight: 500; }
  .buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .join { transition: transform 180ms ease, color 180ms ease, translate 450ms var(--ease-expo); }
  .join:hover { color: var(--color-orange); }
  .wa { border: 1.5px solid var(--color-black); color: var(--color-black); }
  .wa:hover { background: var(--color-black); color: var(--color-cream); }

  .card {
    padding: clamp(1.75rem, 3vw, 2.75rem); border-radius: var(--radius-card);
    background: var(--color-black); color: var(--color-cream); box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35);
  }
  form { display: flex; flex-direction: column; gap: 18px; }
  form[hidden] { display: none; }
  .intro { display: flex; flex-direction: column; gap: 6px; }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 36px; line-height: 1; text-transform: uppercase; }
  .intro p { margin: 0; font-size: 14px; color: var(--color-stone); }
  label {
    display: flex; flex-direction: column; gap: 8px;
    font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-stone);
  }
  input, select {
    min-height: 52px; padding: 0 18px; border-radius: var(--radius-input);
    border: 1px solid rgba(245, 240, 232, 0.18); background: var(--color-charcoal); color: var(--color-cream);
    font-size: 16px; font-family: var(--font-body); text-transform: none; letter-spacing: normal; outline: none;
    transition: border-color 180ms ease;
  }
  select { padding: 0 14px; }
  input:focus, select:focus { border-color: var(--color-orange); }
  input::placeholder { color: rgba(245, 240, 232, 0.4); }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 14px; }
  .submit { margin-top: 6px; width: 100%; }
  .privacy { margin: 0; font-size: 12px; line-height: 1.5; color: var(--color-stone); }

  .success { display: flex; flex-direction: column; gap: 16px; min-height: 320px; justify-content: center; }
  .success[hidden] { display: none; }
  .success h3 { font-size: 40px; }
  .success p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--color-stone); }
  .check {
    width: 56px; height: 56px; border-radius: 999px; background: var(--color-orange); color: var(--color-black);
    display: flex; align-items: center; justify-content: center; font-size: 24px;
  }
  .success button {
    align-self: flex-start; min-height: 44px; padding: 0 20px; border-radius: 999px;
    border: 1px solid rgba(245, 240, 232, 0.25); background: transparent; color: var(--color-cream); cursor: pointer;
  }
  .success button:hover { border-color: var(--color-orange); }
</style>
