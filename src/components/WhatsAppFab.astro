---
import { site } from '../config';
---

{site.showWhatsApp && (
  <a href={site.whatsappUrl} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" class="fab">
    <span class="icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.1.1.7-.2 1.4Z"></path></svg>
    </span>
    <span class="label">WhatsApp</span>
  </a>
)}

<style>
  .fab {
    position: fixed; right: clamp(16px, 2.5vw, 32px); bottom: clamp(16px, 2.5vw, 32px); z-index: 60;
    display: flex; align-items: center; gap: 10px; min-height: 56px; padding: 8px;
    border-radius: 999px; background: var(--color-cream); color: var(--color-black);
    font-family: var(--font-ui); font-weight: 600; font-size: 15px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4); transition: transform 180ms ease;
  }
  .fab:hover { transform: translateY(-2px); color: var(--color-black); }
  .icon {
    width: 40px; height: 40px; border-radius: 999px; background: var(--color-whatsapp);
    display: flex; align-items: center; justify-content: center;
  }
  .label { display: none; }
  @media (min-width: 900px) {
    .fab { padding-right: 22px; }
    .label { display: inline; }
  }
</style>
