---
import type { ImageMetadata } from 'astro';
import ImageSlot from './ImageSlot.astro';
import { site } from '../config';
import gal1 from '../assets/images/gal-1.jpg';
import gal2 from '../assets/images/gal-2.jpg';
import gal3 from '../assets/images/gal-3.jpg';
import gal4 from '../assets/images/gal-4.jpg';
import gal5 from '../assets/images/gal-5.jpg';

// Sample testimonials. Replace with real ones published with consent. No guaranteed-outcome claims.
// Stock photography stands in for member photos until real ones are supplied.
type Slide =
  | { kind: 'image'; ph: string; w: string; img: ImageMetadata; alt: string; tone: 'ember' | 'mono' | 'warm' }
  | { kind: 'quote'; quote: string; who: string; tone: 'dark' | 'orange' };

const gallery: Slide[] = [
  { kind: 'image', ph: 'Community training photo', w: 'clamp(280px,34vw,520px)', img: gal1, alt: 'Athlete sprinting across a court, blurred with speed', tone: 'ember' },
  { kind: 'quote', quote: 'I came for the equipment and stayed for the people. Every coach here knows my name and my numbers.', who: 'Priya Nair · Member since 2023', tone: 'dark' },
  { kind: 'image', ph: 'Member portrait', w: 'clamp(240px,24vw,360px)', img: gal2, alt: 'Member in sportswear holding a basketball', tone: 'mono' },
  { kind: 'image', ph: 'Group class', w: 'clamp(300px,40vw,600px)', img: gal3, alt: 'Members training together in a group class', tone: 'warm' },
  { kind: 'quote', quote: 'Six months in, I finally look forward to training. The 6 am conditioning crew keeps me honest.', who: 'Aditya Menon · Member since 2024', tone: 'orange' },
  { kind: 'image', ph: 'Instagram post', w: 'clamp(240px,24vw,360px)', img: gal4, alt: 'Runner in orange sportswear mid-stride', tone: 'warm' },
  { kind: 'image', ph: 'Training moment', w: 'clamp(280px,34vw,520px)', img: gal5, alt: 'Member working battle ropes in a dark gym', tone: 'ember' },
];
---

<section class="community section--cream">
  <div class="container head">
    <div class="stack">
      <span class="eyebrow" data-reveal="up">05 / Our Community</span>
      <h2 data-reveal="text">Stronger<br /><span class="accent">together.</span></h2>
    </div>
    <div class="controls">
      <span>Drag to explore</span>
      <button type="button" class="prev" data-gallery-prev aria-label="Previous">Prev</button>
      <button type="button" class="next" data-gallery-next aria-label="Next">Next</button>
    </div>
  </div>
  <div class="gallery" data-reveal="slide" data-gallery tabindex="0" aria-label="Community gallery">
    {gallery.map((g) =>
      g.kind === 'quote' ? (
        <figure class:list={['quote', g.tone]}>
          <span class="mark" aria-hidden="true">“</span>
          <blockquote>“{g.quote}”</blockquote>
          <figcaption>{g.who}</figcaption>
        </figure>
      ) : (
        <div class="shot" style={`width:${g.w}`}>
          <ImageSlot label={g.ph} src={g.img} alt={g.alt} tone={g.tone} widths={[400, 700, 1100]} sizes="(min-width: 900px) 40vw, 85vw" />
        </div>
      )
    )}
  </div>
  <div class="container foot">
    <span>Member stories shared with permission.</span>
    <a href={site.instagramUrl}>Follow us on Instagram</a>
  </div>
</section>

<style>
  .community { padding: var(--section-space) 0; }
  .head {
    padding: 0 var(--page-gutter);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 32px; align-items: end;
  }
  h2 {
    margin: 0; font-family: var(--font-display); font-weight: 400;
    font-size: clamp(3.5rem, 9vw, 8rem); line-height: 0.88; text-transform: uppercase;
  }
  .controls { display: flex; justify-content: flex-end; align-items: center; gap: 12px; }
  .controls span { font-family: var(--font-ui); font-size: 14px; color: var(--color-charcoal); }
  .controls button {
    min-width: 64px; padding: 0 18px; height: 52px; border-radius: 999px; cursor: pointer;
    font-family: var(--font-ui); font-weight: 600; font-size: 15px;
    transition: background 180ms ease, color 180ms ease;
  }
  .prev { border: 1px solid rgba(9, 9, 9, 0.2); background: transparent; color: var(--color-black); }
  .prev:hover { background: var(--color-black); color: var(--color-cream); }
  .next { border: none; background: var(--color-black); color: var(--color-cream); }
  .next:hover { background: var(--color-orange); color: var(--color-black); }
  .gallery {
    margin-top: clamp(2.5rem, 5vw, 4rem); display: flex; gap: 20px; overflow-x: auto;
    scroll-snap-type: x mandatory; padding: 28px var(--page-gutter) 36px; scroll-padding-inline: var(--page-gutter);
    scrollbar-width: none; cursor: grab; user-select: none;
  }
  .gallery::-webkit-scrollbar { display: none; }
  .gallery > * {
    flex: none; scroll-snap-align: start; height: clamp(380px, 38vw, 520px); border-radius: var(--radius-card);
    box-shadow: 0 24px 50px rgba(9, 9, 9, 0.18);
    transition: rotate 500ms var(--ease-expo), translate 500ms var(--ease-expo);
  }
  /* Fanned, slightly tilted cards, straightening on hover */
  .gallery > :nth-child(4n + 1) { rotate: -2.5deg; }
  .gallery > :nth-child(4n + 2) { rotate: 1.5deg; translate: 0 -14px; }
  .gallery > :nth-child(4n + 3) { rotate: -1deg; translate: 0 10px; }
  .gallery > :nth-child(4n + 4) { rotate: 2.5deg; }
  .gallery > :hover { rotate: 0deg; translate: 0 -6px; }
  .shot { position: relative; overflow: hidden; }
  .shot :global(img) { pointer-events: none; }
  .quote {
    width: clamp(280px, 30vw, 420px); margin: 0; padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .quote.dark { background: var(--color-black); color: var(--color-cream); --accent: var(--color-orange); }
  .quote.orange { background: var(--color-orange); color: var(--color-black); --accent: var(--color-black); }
  .mark { font-family: var(--font-display); font-size: 80px; line-height: 0.6; color: var(--accent); }
  blockquote {
    margin: 0; font-family: var(--font-ui); font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;
  }
  figcaption { font-family: var(--font-ui); font-size: 14px; opacity: 0.8; }
  .foot {
    margin-top: 28px; padding: 0 var(--page-gutter);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-family: var(--font-ui); font-size: 14px; color: var(--color-charcoal);
  }
  .foot a { font-weight: 600; color: var(--color-black); }
  .foot a:hover { color: var(--color-deep-orange); }
</style>
